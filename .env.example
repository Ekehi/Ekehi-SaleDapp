# Copy this file to `.env.local` and fill in the values.
# These are public env vars (NEXT_PUBLIC_*) and will be embedded in the client bundle.
# Do NOT put any secrets here.

# Alchemy (only needed if you use an Alchemy-supported chain like Ethereum/Polygon)
NEXT_PUBLIC_ALCHEMY_ID=your_alchemy_project_id

# Chain selection
# Example IDs: 1 (Ethereum), 137 (Polygon), 97 (BSC Testnet), 56 (BSC Mainnet), 80002 (Polygon Amoy)
NEXT_PUBLIC_CHAIN_ID=137

# RPC URL for the selected chain (used by wallet/connectors/providers as fallback)
# e.g., https://polygon-rpc.com or https://data-seed-prebsc-1-s2.binance.org:8545
NEXT_PUBLIC_RPC_URL=https://polygon-rpc.com

# Presale contract
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYourPresaleContractAddress

# The ABI for the presale contract as a JSON string.
# Put the full JSON array on a single line or properly escaped multiline string.
# Example: [{"inputs":[...],"name":"presale","outputs":[...],"stateMutability":"view","type":"function"}, ...]
NEXT_PUBLIC_CONTRACT_ABI=[YOUR_PRESALE_CONTRACT_ABI_JSON_ARRAY]

# Stablecoin (USDT or equivalent) contract ABI for allowance/approve
NEXT_PUBLIC_STABLE_COIN_CONTRACT_ABI=[YOUR_STABLECOIN_CONTRACT_ABI_JSON_ARRAY]

# Presale ID (uint) used by the contract when multiple presales exist
NEXT_PUBLIC_PRESALE_ID=0